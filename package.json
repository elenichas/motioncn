{
  "name": "motioncn",
  "version": "1.0.0",
  "description": "Animated extensions for shadcn/ui, on an infinite canvas. Installable with the shadcn CLI.",
  "scripts": {
    "dev": "vite",
    "build": "npm run registry && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "registry": "node scripts/build-registry.mjs && rm -rf public/r && shadcn build -o public/r",
    "registry:verify": "node scripts/verify-registry.mjs",
    "test": "npm run registry:verify",
    "scan": "node scripts/scan-project.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "type": "module"
}
